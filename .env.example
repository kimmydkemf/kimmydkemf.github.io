# 저장소 루트에 .env 로 복사해서 사용 (.env 는 git 에 올라가지 않음)
#   cp .env.example .env

# 필수 — private 레포 포함 조회. Fine-grained PAT 권장 (대상 레포 Contents: read, Metadata: read)
GITHUB_TOKEN=

# 선택 — 있으면 Claude 가 README 를 요약해 카드 문장을 만든다
ANTHROPIC_API_KEY=

# 선택 — 지정 시 sync 할 때 Obsidian vault 의 개발/ 폴더에 프로젝트 md 생성
OBSIDIAN_VAULT=

# 선택 — 지정 시 Update Portfolio 는 이 브랜치에서만 commit/push 허용 (예: main)
PORTFOLIO_BRANCH=
